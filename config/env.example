# mroffice environment configuration template
# Copy to .env and fill in values. Never commit .env with secrets.

# Runtime (quoted: values contain a space; compose's own .env parser needs the quotes)
RUNTIME=podman
COMPOSE=podman compose

# Deployment
PROFILE=local
ENV=dev
HOST=local
STACK=all
DATA_ROOT=/srv/mroffice

# Backups
BACKUP_TARGET=/var/backups/mroffice

# Network / Domains
NEXTCLOUD_DOMAIN=nextcloud.local
PAPERLESS_DOMAIN=paperless.local
COLLABORA_DOMAIN=collabora.local
TZ=UTC

# TLS
TLS_MODE=selfsigned  # selfsigned|reverse-proxy|letsencrypt

# Nextcloud AIO
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_DATADIR=${DATA_ROOT}/nextcloud/data
AIO_PORT=8080
APACHE_PORT=443

# Paperless-ngx (local unified stack — compose/paperless.yml)
# All persistent state is under ${DATA_ROOT}/paperless/ (bind mounts, never named volumes).
PAPERLESS_PORT=8000
PAPERLESS_ADMIN_USER=admin
PAPERLESS_URL=http://localhost:8000
# Extra hostnames/IPs allowed to serve the UI (in addition to PAPERLESS_URL's host).
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,webserver
PAPERLESS_CONSUME_DIR=${DATA_ROOT}/paperless/consume
PAPERLESS_MEDIA_DIR=${DATA_ROOT}/paperless/media
PAPERLESS_DATA_DIR=${DATA_ROOT}/paperless/data
PAPERLESS_EXPORT_DIR=${DATA_ROOT}/paperless/export
PAPERLESS_DBDIR=${DATA_ROOT}/paperless/pgdata
PAPERLESS_OCR_LANGUAGE=por+eng
PAPERLESS_OCR_LANGUAGES=por
PAPERLESS_CONSUMER_DELETE_DUPLICATES=0
POSTGRES_DB=paperless
POSTGRES_USER=paperless
# POSTGRES_PASSWORD lives in config/.secrets.env (generated by make init)
# PAPERLESS_SECRET_KEY lives in config/.secrets.env (generated by make init)
USERMAP_UID=1000
USERMAP_GID=1000
# On rootless podman hosts set both to 0 so consume/media stay writable by the SSH user.
# USERMAP_UID=0
# USERMAP_GID=0
COMPOSE_PROJECT_NAME=mroffice

# --- Native AI (Paperless-ngx 3.x, optional, needs COMPOSE_PROFILES=ai) ---
# PAPERLESS_AI_ENABLED=1 enables title/tags/correspondent/type suggestions, chat, similar docs.
PAPERLESS_AI_ENABLED=0
PAPERLESS_AI_BACKEND=ollama
PAPERLESS_AI_LLM_ENDPOINT=http://ollama:11434
PAPERLESS_AI_LLM_MODEL=qwen3:8b
PAPERLESS_AI_EMBEDDINGS_BACKEND=ollama
PAPERLESS_AI_EMBEDDINGS_ENDPOINT=http://ollama:11434
PAPERLESS_AI_EMBEDDINGS_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
# OLLAMA_PORT=11434  # uncomment to publish ollama on localhost (default: internal only)

# Integration
INTEGRATION_MODE=consume-drop  # consume-drop|api-push|bridge
PAPERLESS_API_URL=http://localhost:8000
NEXTCLOUD_PAPERLESS_SHARE=Paperless-Ingest

# Reverse proxy (if used)
REVERSE_PROXY_NETWORK=proxy

# Secrets - generated by make secrets/init, stored in config/.secrets.env (gitignored)
# NEXTCLOUD_ADMIN_PASSWORD=
# PAPERLESS_ADMIN_PASSWORD=
# PAPERLESS_API_TOKEN=
# PAPERLESS_SECRET_KEY=
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
