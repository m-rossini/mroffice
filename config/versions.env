# Pinned image versions with digests
# Update explicitly via make update, never use :latest
# Tags live here; digests are resolved on `make pull` and recorded alongside.

# Nextcloud AIO
NEXTCLOUD_AIO_MASTERCONTAINER_IMAGE=nextcloud/all-in-one:latest
NEXTCLOUD_AIO_MASTERCONTAINER_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST

# Paperless-ngx (unified local stack — compose/paperless.yml)
# Paperless 3.5.1 = current stable with native AI (Nov 2026). Gotenberg/Tika pins are
# load-bearing: tika:latest (4.x) breaks Office ingestion (tika-client calls
# /tika/form/text, dropped in 4.x); gotenberg-client 1.0.0 needs 8.38.x.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.5.1
PAPERLESS_IMAGE_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
PAPERLESS_POSTGRES_IMAGE=docker.io/library/postgres:16
PAPERLESS_POSTGRES_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
PAPERLESS_REDIS_IMAGE=docker.io/library/redis:7
PAPERLESS_REDIS_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
PAPERLESS_BROKER_IMAGE=docker.io/library/redis:7
PAPERLESS_BROKER_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
PAPERLESS_GOTENBERG_IMAGE=docker.io/gotenberg/gotenberg:8.38.1
PAPERLESS_GOTENBERG_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
PAPERLESS_TIKA_IMAGE=docker.io/apache/tika:3.3.3.0
PAPERLESS_TIKA_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
# Optional local LLM for PAPERLESS_AI_* (only pulled with COMPOSE_PROFILES=ai)
OLLAMA_IMAGE=docker.io/ollama/ollama:0.40.14
OLLAMA_IMAGE_DIGEST=sha256:PLACEHOLDER_UPDATE_WITH_ACTUAL_DIGEST
